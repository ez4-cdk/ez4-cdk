<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="150dp"
    android:layout_marginVertical="10dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/border">

    <TextView
        android:id="@+id/book_name_tag"
        android:text="@string/book_name_tag"
        android:layout_width="70dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/book_upload_time_tag"
        android:layout_marginHorizontal="20dp"
        app:layout_constraintStart_toStartOf="parent"
        />

    <TextView
        android:id="@+id/book_name"
        android:hint="@string/loading"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/book_upload_time"
        android:layout_marginHorizontal="20dp"
        app:layout_constraintStart_toEndOf="@id/book_name_tag"
        />

    <TextView
        android:id="@+id/book_upload_time_tag"
        android:text="@string/upload_time_tag"
        android:layout_width="70dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        app:layout_constraintTop_toBottomOf="@id/book_name_tag"
        app:layout_constraintBottom_toTopOf="@+id/book_read_progress_tag"
        app:layout_constraintStart_toStartOf="parent"
        />

    <TextView
        android:id="@+id/book_upload_time"
        android:hint="@string/loading"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        app:layout_constraintTop_toBottomOf="@id/book_name"
        app:layout_constraintBottom_toTopOf="@id/book_read_progress"
        android:layout_marginHorizontal="20dp"
        app:layout_constraintStart_toEndOf="@id/book_upload_time_tag"
        />

    <TextView
        android:id="@+id/book_read_progress_tag"
        android:text="@string/read_progress_tag"
        android:layout_width="70dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        app:layout_constraintTop_toBottomOf="@id/book_upload_time_tag"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />

    <TextView
        android:id="@+id/book_read_progress"
        android:hint="@string/loading"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/book_upload_time"
        android:layout_marginHorizontal="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/book_read_progress_tag"
        />



</androidx.constraintlayout.widget.ConstraintLayout>