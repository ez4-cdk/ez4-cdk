<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/music_bg"
        android:layout_height="match_parent"
        android:layout_width="match_parent">
        <ImageView
            android:padding="32dp"
            android:alpha="0.6"
            android:id="@+id/music_song_img"
            android:src="@drawable/music_play"
            android:layout_marginBottom="200dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_width="200dp"
            android:layout_height="200dp"/>

        <SeekBar
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/music_song_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:id="@+id/music_progress_bar"/>

        <TextView
            android:textStyle="italic"
            android:id="@+id/music_song_detail"
            android:text="@string/music_song_detail"
            android:textColor="@color/black"
            android:ellipsize="marquee"
            android:singleLine="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:marqueeRepeatLimit="-1"
            android:textSize="24sp"
            android:padding="16dp"
            android:gravity="center"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="100dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

    </androidx.constraintlayout.widget.ConstraintLayout>


    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/music_bnv"
        android:alpha="0.70"
        app:itemIconTint="@drawable/center_bnv"
        app:itemTextColor="@color/black"
        android:background="@color/transparent"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/music_opts"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_gravity="bottom"
        />

    <FrameLayout
        android:id="@+id/music_bsb"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        >
        <TextView
            android:padding="8dp"
            android:text="@string/music_list_tag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <androidx.recyclerview.widget.RecyclerView
            android:layout_marginBottom="56dp"
            android:layout_marginTop="30dp"
            android:padding="10dp"
            android:id="@+id/music_list_rv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>